+    def _effective_domains(self, query: tuple[tuple[int, int], ...]) -> dict[int, int]:
+        domains: dict[int, int] = {}
+        for vertex, allowed in query:
+            domains[vertex] = domains.get(vertex, self.masks[vertex]) & allowed
+        return domains
