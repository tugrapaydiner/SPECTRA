include docs/DEDUCTIVE_GUIDE.md docs/EFFICIENCY_GUIDE.md docs/RUNTIME_GUIDE.md
include docs/COMPILER_BASELINE_GUIDE.md docs/TRAINED_FP_GUIDE.md
include docs/SVM.md docs/SVM_BINARY_STREAM.md docs/SVM_FUSED.md
include docs/SVM_PIPELINE.md docs/SVM_PORTABILITY.md docs/SVM_PREPROCESS_NATIVE.md
include docs/SVM_RECEIPTS.md docs/SVM_SHARED.md docs/SVM_STREAM.md
include docs/history/README.md
recursive-include spectra/_native *.cpp *.h *.hpp
include assets/readme/*.svg assets/readme/chart-data.json
