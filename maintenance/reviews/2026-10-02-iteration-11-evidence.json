  "retained_check_recipe": "\"\"\"Read-only identity check of iteration-06 receipts; not a benchmark re-audit.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom experiments.tree_total.audit import TASKS, replay_model_bindings\n\nbase = Path('.review/06-retained')\nsdk = base / 'original/SPECTRA-residual-evidence/baseline_sdk'\nmodels = base / 'replay-portable'\nreplay = json.loads((models / 'LOCK.json').read_text())\nproof = json.loads((base / 'independent.json').read_text())\nfiles, bindings = {}, {}\nfor task in TASKS:\n    for name in ('model.json', 'input.u8', 'indices.i32', 'flat.sctt', 'interned.sctt'):\n        path = (models / task / name if name.endswith('.sctt') else sdk / 'models' / task / name)\n        bindings[task + '/' + name] = str(path)\n        files[str(path)] = hashlib.sha256(path.read_bytes()).hexdigest()\nreplay_model_bindings(replay, files, bindings)\nchecked = []\nfor entry in proof['files']:\n    task, layout = entry['task'], entry['layout']\n    source_hash = files[bindings[task + '/model.json']]\n    model_hash = files[bindings[task + '/' + layout + '.sctt']]\n    if entry['source_sha256'] != source_hash or entry['sha256'] != model_hash:\n        raise ValueError('retained proof identity mismatch')\n    checked.append({'task': task, 'layout': layout, 'source_sha256': source_hash, 'sha256': model_hash})\nresult = {'status': 'PASS', 'replay_tasks': len(TASKS), 'proof_files': len(checked),\n          'files': checked, 'scope': 'identity comparison of existing iteration-06 receipts and current retained bytes; no new inference, timing or full historical audit'}\nout = Path('.review/11-replay-bindings/retained-identities.json')\nwith out.open('x') as stream:\n    json.dump(result, stream, indent=2)\nprint(json.dumps({k:v for k,v in result.items() if k != 'files'}))\n",
